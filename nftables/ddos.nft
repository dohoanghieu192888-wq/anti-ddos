#!/usr/sbin/nft -f
# =====================================================================
#  DDoS Hardening Firewall - nftables
#  Ubuntu 20.04 (nft 0.9.3 / kernel 5.4)
#
#  Cài đặt : install.sh  (copy vào /etc/nftables.d/ddos.nft)
#  Nạp tay : nft -f /etc/nftables.d/ddos.nft
#  Kiểm tra: nft -c -f /etc/nftables.d/ddos.nft     (chỉ check, không áp dụng)
#  Xem rule: nft list ruleset
#
#  >>> SỬA CỔNG DỊCH VỤ Ở MỤC "DỊCH VỤ ĐƯỢC PHÉP" BÊN DƯỚI <<<
# =====================================================================

# ---------------------------------------------------------------------
# 1) BẢNG RAW (prerouting, trước conntrack)
#    Chặn ngay các gói tin rác => rẻ CPU nhất, giảm tải cho conntrack.
#    Idempotent: khai báo rỗng -> xoá -> khai báo thật (nạp lại nhiều lần
#    không bị nhân đôi rule và không đụng tới rule của Docker/fail2ban).
# ---------------------------------------------------------------------
table inet ddos_raw {}
delete table inet ddos_raw

table inet ddos_raw {
	chain prerouting {
		type filter hook prerouting priority raw; policy accept;

		iif "lo" accept

		# Gói tin IPv4 bị phân mảnh (fragment) - vector flood giá rẻ
		ip frag-off & 0x1fff != 0 counter drop

		# Tổ hợp cờ TCP bất hợp lệ: dấu hiệu scan / flood / trốn IDS
		tcp flags & (fin|syn) == (fin|syn) counter drop
		tcp flags & (syn|rst) == (syn|rst) counter drop
		tcp flags & (fin|rst) == (fin|rst) counter drop
		tcp flags & (fin|ack) == fin counter drop
		tcp flags & (ack|urg) == urg counter drop

		# ------------------------------------------------------------------
		# SYN FLOOD: giới hạn SYN theo TỪNG IP nguồn.
		#   60 syn/giây, burst 120 gói. IP vượt hạn mức bị drop ngay tại
		#   đây nên không bao giờ vào tới SYN backlog / conntrack.
		#   Tăng lên nếu bạn có NAT/proxy hợp lệ phía trước.
		# ------------------------------------------------------------------
		tcp flags & (fin|syn|rst|ack) == syn \
			meter syn_flood_v4 { ip saddr limit rate over 60/second burst 120 packets } \
			counter drop
		tcp flags & (fin|syn|rst|ack) == syn \
			meter syn_flood_v6 { ip6 saddr limit rate over 60/second burst 120 packets } \
			counter drop
	}
}

# ---------------------------------------------------------------------
# 2) BẢNG FILTER: chính sách mặc định DROP toàn bộ
# ---------------------------------------------------------------------
table inet filter {}
delete table inet filter

table inet filter {
	# IP/CIDR bị chặn vĩnh viễn (do scripts/update-blocklist.sh nạp vào)
	set blackhole_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		size 262144
	}
	set blackhole_v6 {
		type ipv6_addr
		flags interval
		auto-merge
		size 65536
	}
	# IP/CIDR luôn được tin tưởng (admin, monitoring, CDN, load balancer)
	set whitelist_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		size 4096
	}
	set whitelist_v6 {
		type ipv6_addr
		flags interval
		auto-merge
		size 4096
	}

	# Chain rỗng, chỉ dùng khi scripts/emergency-mode.sh on
	chain emergency {
	}

	chain input {
		type filter hook input priority filter; policy drop;

		counter comment "total-in"

		# --- Loopback
		iif "lo" accept

		# --- Kết nối đã thiết lập: cho qua ngay (nhanh nhất)
		ct state established,related accept

		# --- Gói tin sai trạng thái conntrack (giả mạo, out-of-window)
		ct state invalid counter drop

		# --- Whitelist (đặt TRƯỚC blackhole)
		ip saddr @whitelist_v4 accept
		ip6 saddr @whitelist_v6 accept

		# --- Blocklist
		ip saddr @blackhole_v4 counter drop
		ip6 saddr @blackhole_v6 counter drop

		# --- Rule khẩn cấp (rỗng khi bình thường)
		jump emergency

		# --- ICMP: rate limit, tránh ping flood / smurf
		ip protocol icmp icmp type echo-request \
			limit rate 10/second burst 20 packets accept
		ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		ip protocol icmp counter drop

		# --- ICMPv6 (bắt buộc cho neighbor discovery / PMTU)
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		icmpv6 type echo-request limit rate 10/second burst 20 packets accept
		icmpv6 counter drop

		# ------------------------------------------------------------------
		# UDP AMPLIFICATION: chặn các cổng UDP hay bị lợi dụng để khuếch đại
		# (chargen, NTP, NetBIOS, SNMP, LDAP, SSDP, memcached, mDNS, game).
		# >>> BỎ số của cổng mà bạn THỰC SỰ chạy server (ví dụ 53 nếu là DNS).
		# ------------------------------------------------------------------
		udp dport { 19, 123, 137, 161, 389, 1900, 11211, 5353, 27015 } counter drop

		# --- Chống quét cổng: 1 IP tạo > 25 kết nối mới/giây => drop
		tcp flags & (fin|syn|rst|ack) == syn ct state new \
			meter newconn_v4 { ip saddr limit rate over 25/second burst 50 packets } \
			counter drop

		# --- Giới hạn số kết nối đồng thời trên mỗi IP (chống slowloris
		#     và flood giữ kết nối). 60 kết nối / IP cho web.
		ct state new tcp dport { 80, 443 } \
			meter web_conn_v4 { ip saddr ct count over 60 } counter drop
		ct state new tcp dport { 80, 443 } \
			meter web_conn_v6 { ip6 saddr ct count over 60 } counter drop

		# ==================================================================
		#  DỊCH VỤ ĐƯỢC PHÉP  (SỬA Ở ĐÂY)
		# ==================================================================

		# --- SSH: rate limit chống brute-force, quá hạn mức thì drop + log
		tcp dport 22 ct state new \
			meter ssh_v4 { ip saddr limit rate over 6/minute burst 10 packets } \
			counter accept
		tcp dport 22 ct state new \
			limit rate 5/minute log prefix "nft-ssh-flood: " level warn
		tcp dport 22 ct state new counter drop

		# --- HTTP / HTTPS
		tcp dport { 80, 443 } ct state new counter accept

		# --- Thêm dịch vụ khác tại đây, ví dụ:
		# tcp dport 8443 ct state new counter accept
		# tcp dport 53  counter accept          # DNS server
		# udp dport 53  counter accept
		# tcp dport 25  ct state new counter accept

		# --- Còn lại: log có giới hạn (tránh tự làm ngập log) rồi drop
		limit rate 20/minute log prefix "nft-input-drop: " level info
		counter drop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		# Chiều về của các kết nối đã thiết lập
		ct state established,related accept

		# Module mở rộng (game proxy NAT, VPN, container...) tự sinh file này.
		# Mặc định rỗng - do install.sh hoặc game-proxy/install-proxy.sh tạo.
		include "/etc/ddos/forward-extra.rules"

		counter comment "forward-drop"
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}

# =====================================================================
#  GHI CHÚ
#  - Dùng Docker/Kubernetes? chain forward policy drop sẽ chặn container.
#    Đổi thành:  policy accept;  hoặc thêm rule riêng cho docker0/br-*.
#  - Kiểm tra nhanh: nft list table inet filter
#  - Đếm gói bị drop: scripts/status.sh
# =====================================================================
