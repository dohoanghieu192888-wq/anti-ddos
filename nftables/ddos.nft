#!/usr/sbin/nft -f

table inet ddos_raw {}
delete table inet ddos_raw

table inet ddos_raw {
	chain prerouting {
		type filter hook prerouting priority raw; policy accept;

		iif "lo" accept
		ip frag-off & 0x1fff != 0 counter drop
		tcp flags & (fin|syn) == (fin|syn) counter drop
		tcp flags & (syn|rst) == (syn|rst) counter drop
		tcp flags & (fin|rst) == (fin|rst) counter drop
		tcp flags & (fin|ack) == fin counter drop
		tcp flags & (ack|urg) == urg counter drop
		tcp flags & (fin|syn|rst|ack) == syn \
			meter syn_v4 { ip saddr limit rate over 60/second burst 120 packets } counter drop
		tcp flags & (fin|syn|rst|ack) == syn \
			meter syn_v6 { ip6 saddr limit rate over 60/second burst 120 packets } counter drop
	}
}

table inet filter {}
delete table inet filter

table inet filter {
	set blackhole_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		size 262144
	}
	set blackhole_v6 {
		type ipv6_addr
		flags interval
		auto-merge
		size 65536
	}
	set whitelist_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		size 4096
	}
	set whitelist_v6 {
		type ipv6_addr
		flags interval
		auto-merge
		size 4096
	}

	chain emergency {
	}

	chain proxy_fwd {
	}

	chain local_svc {
	}

	chain input {
		type filter hook input priority filter; policy drop;

		counter
		iif "lo" accept
		ct state established,related accept
		ct state invalid counter drop

		ip saddr @whitelist_v4 accept
		ip6 saddr @whitelist_v6 accept
		ip saddr @blackhole_v4 counter drop
		ip6 saddr @blackhole_v6 counter drop

		jump emergency

		icmp type echo-request limit rate 10/second burst 20 packets accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		meta l4proto icmp counter drop
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		icmpv6 type echo-request limit rate 10/second burst 20 packets accept
		meta l4proto ipv6-icmp counter drop

		udp dport { 19, 123, 137, 161, 389, 1900, 11211, 5353, 27015 } counter drop

		ct state new tcp flags & (fin|syn|rst|ack) == syn \
			meter newconn_v4 { ip saddr limit rate over 25/second burst 50 packets } counter drop
		ct state new tcp flags & (fin|syn|rst|ack) == syn \
			meter newconn_v6 { ip6 saddr limit rate over 25/second burst 50 packets } counter drop

		ct state new tcp dport { 80, 443 } \
			meter webconn_v4 { ip saddr ct count over 60 } counter drop
		ct state new tcp dport { 80, 443 } \
			meter webconn_v6 { ip6 saddr ct count over 60 } counter drop

		tcp dport 22 ct state new \
			meter ssh_v4 { ip saddr limit rate over 6/minute burst 10 packets } counter accept
		tcp dport 22 ct state new limit rate 5/minute log prefix "nft-ssh-flood: " level warn
		tcp dport 22 ct state new counter drop

		tcp dport { 80, 443 } ct state new counter accept

		jump local_svc

		limit rate 20/minute log prefix "nft-input-drop: " level info
		counter drop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		jump proxy_fwd
		counter
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
