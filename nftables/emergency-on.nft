#!/usr/sbin/nft -f

flush chain inet filter emergency

table inet filter {
	chain emergency {
		tcp flags & (fin|syn|rst|ack) == syn \
			meter emg_syn { ip saddr limit rate over 15/second burst 30 packets } counter drop
		ct state new \
			meter emg_new { ip saddr limit rate over 25/second burst 50 packets } counter drop
		ct state new tcp dport { 80, 443 } \
			meter emg_conn { ip saddr ct count over 20 } counter drop
		tcp dport 22 ct state new \
			meter emg_ssh { ip saddr limit rate over 2/minute burst 3 packets } counter accept
		tcp dport 22 ct state new limit rate 10/minute log prefix "nft-emergency-ssh: " level warn
		tcp dport 22 ct state new counter drop
		udp dport { 19, 53, 123, 137, 161, 389, 1900, 11211, 5353, 27015 } counter drop
	}
}
